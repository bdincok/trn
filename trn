# --- Sekmeler ---
tab_liste, tab_yeni, tab_degerlendirme = st.tabs([
    "📋 TRN Takip ve Liste",
    "➕ Yeni Personel Girişi",
    "✍️ Mentor Değerlendirme & Release"
])

# 1. SEKME: LİSTE
with tab_liste:
    col_search, col_filter, col_toggle = st.columns([2, 1.5, 1])
    
    with col_search:
        arama = st.text_input("🔍 Sicil, Personel veya Mentor Ara", placeholder="Örn: LH1024, Selin, Ahmet...")
    with col_filter:
        durum_filtre = st.multiselect(
            "Duruma Göre Filtrele",
            options=df_all["Durum"].unique(),
            default=[]
        )
    with col_toggle:
        st.write("")
        st.write("")
        sadece_aksiyon = st.checkbox("Yalnızca Aksiyon Gerekenler", value=False)

    filtered_df = df_all.copy()
    if arama:
        filtered_df = filtered_df[
            filtered_df["Sicil No"].str.contains(arama, case=False, na=False) |
            filtered_df["Personel Adı"].str.contains(arama, case=False, na=False) |
            filtered_df["Mentor"].str.contains(arama, case=False, na=False)
        ]
    if durum_filtre:
        filtered_df = filtered_df[filtered_df["Durum"].isin(durum_filtre)]
    if sadece_aksiyon:
        filtered_df = filtered_df[(filtered_df["Durum"] == "Aksiyon Gerekiyor") | (filtered_df["Vardiya Uyumu"].str.contains("Uyumsuz"))]

    display_df = filtered_df[[
        "Sicil No", "Personel Adı", "Mentor", "Vardiya Uyumu", 
        "TRN Başlangıç", "Geçen Süre (Gün)", "Kalan Gün", "Durum"
    ]]

    st.dataframe(display_df, use_container_width=True)

    csv = display_df.to_csv(index=False).encode('utf-8-sig')
    st.download_button(
        label="📥 Tabloyu Excel/CSV Olarak İndir",
        data=csv,
        file_name=f"lufthansa_trn_raporu_{date.today().strftime('%Y%m%d')}.csv",
        mime="text/csv"
    )

# 2. SEKME: YENİ GİRİŞ
with tab_yeni:
    st.subheader("Yeni Menti / TRN Kaydı")
    with st.form("yeni_personel_formu", clear_on_submit=True):
        col1, col2 = st.columns(2)
        with col1:
            yeni_sicil = st.text_input("Sicil Numarası *", placeholder="LH1099")
            yeni_ad = st.text_input("Ad Soyad *", placeholder="Örn: Zeynep Kaya")
            yeni_sinif = st.text_input("3 Günlük Sınıf Eğitimi Tarihleri", value="20-22 Ekim 2026")
        
        with col2:
            yeni_mentor = st.text_input("Atanan Mentor Adı *", placeholder="Örn: Murat Öztürk")
            yeni_vardiya = st.selectbox("Mentor-Menti Vardiya Uyumu", ["Uyumlu", "Uyumsuz (Revize Gerekli)"])
            yeni_baslangic = st.date_input("Kontuar TRN Başlangıç Tarihi", value=date.today())
            
        st.info("💡 Minimum 60 günlük operasyonel eğitim süresi başlangıç tarihinden itibaren sistem tarafından otomatik hesaplanacaktır.")
        
        submitted = st.form_submit_button("Personeli Sisteme Kaydet")
        if submitted:
            if not yeni_sicil or not yeni_ad or not yeni_mentor:
                st.error("Lütfen yıldızlı (*) zorunlu alanları doldurun.")
            else:
                yeni_kayit = {
                    "sicil_no": yeni_sicil.strip().upper(),
                    "ad_soyad": yeni_ad.strip(),
                    "sinif_egitimi": yeni_sinif,
                    "mentor": yeni_mentor.strip(),
                    "vardiya_uyumu": yeni_vardiya,
                    "kontuar_baslangic": yeni_baslangic,
                    "mentor_notu": "Henüz değerlendirme girilmedi.",
                    "release_aciklama": "-",
                    "durum": "Kontuar TRN (Devam Ediyor)" if yeni_vardiya == "Uyumlu" else "Aksiyon Gerekiyor"
                }
                st.session_state.trn_data.append(yeni_kayit)
                st.success(f"✅ {yeni_ad} ({yeni_sicil}) başarıyla kaydedildi!")
                trigger_rerun()

# 3. SEKME: DEĞERLENDİRME & RELEASE
with tab_degerlendirme:
    st.subheader("Mentor Değerlendirme & Release Onay Ekranı")
    
    secenekler = [f"{p['sicil_no']} - {p['ad_soyad']}" for p in st.session_state.trn_data]
    secilen = st.selectbox("İşlem Yapılacak Personeli Seçin", secenekler)
    
    if secilen:
        secilen_sicil = secilen.split(" - ")[0]
        personel = next(p for p in st.session_state.trn_data if p["sicil_no"] == secilen_sicil)
        
        gecen = (date.today() - personel["kontuar_baslangic"]).days
        kalan = max(0, 60 - gecen)
        
        st.write("---")
        c1, c2, c3 = st.columns(3)
        c1.metric("Kontuar TRN Başlangıç", personel["kontuar_baslangic"].strftime("%d.%m.%Y"))
        c2.metric("Tamamlanan Gün", f"{gecen} Gün")
        c3.metric("Kalan Asgari Süre", f"{kalan} Gün")
        
        if gecen >= 60:
            st.success("🟢 60 günlük asgari kontuar süresi doldurulmuştur. Release kararı verilebilir.")
        else:
            st.warning(f"⏳ 60 günlük asgari süre dolmamıştır. Release verilebilmesi için personelin **{kalan} gün** daha eğitim alması gerekmektedir.")
        
        with st.form("degerlendirme_formu"):
            yeni_mentor_notu = st.text_area("Mentor Performans Değerlendirmesi", value=personel["mentor_notu"])
            yeni_release_notu = st.text_area("Lufthansa İstasyon / Release Açıklaması", value=personel["release_aciklama"])
            
            durum_listesi = ["Kontuar TRN (Devam Ediyor)", "Değerlendirme Aşaması", "Release Verildi", "Aksiyon Gerekiyor"]
            mevcut_index = durum_listesi.index(personel["durum"]) if personel["durum"] in durum_listesi else 0
            
            yeni_durum = st.selectbox("Süreç Durumunu Güncelle", durum_listesi, index=mevcut_index)
            
            kaydet_btn = st.form_submit_button("Değerlendirmeyi Kaydet")
            if kaydet_btn:
                if yeni_durum == "Release Verildi" and gecen < 60:
                    st.error(f"❌ Kural İhlali: Personel 60 günü tamamlamadan ({gecen}/60) 'Release Verildi' durumuna alınamaz!")
                else:
                    personel["mentor_notu"] = yeni_mentor_notu
                    personel["release_aciklama"] = yeni_release_notu
                    personel["durum"] = yeni_durum
                    st.success("Değerlendirme ve süreç başarıyla güncellendi.")
                    trigger_rerun()
