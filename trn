# --- Tablo Verisi Hazırlama ---
def get_df():
    records = []
    bugun = date.today()
    for item in st.session_state.trn_data:
        gecen_gun = (bugun - item["kontuar_baslangic"]).days
        hedef_tarih = item["kontuar_baslangic"] + timedelta(days=60)
        kalan_gun = max(0, 60 - gecen_gun)
        
        records.append({
            "Sicil No": item["sicil_no"],
            "Personel Adı": item["ad_soyad"],
            "Mentor": item["mentor"],
            "Vardiya Uyumu": item["vardiya_uyumu"],
            "TRN Başlangıç": item["kontuar_baslangic"].strftime("%d.%m.%Y"),
            "Geçen Süre (Gün)": gecen_gun,
            "60 Gün Hedefi": hedef_tarih.strftime("%d.%m.%Y"),
            "Kalan Gün": kalan_gun,
            "Durum": item["durum"]
        })
    return pd.DataFrame(records)

df_all = get_df()

